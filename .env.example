# Copy to .env (git-ignored) and replace every change-me value. Never commit .env.

# HTTP API (`make run-api`). In containers (make stack-up) the API listens on
# 0.0.0.0:8080 inside and is published on 127.0.0.1:API_PORT; the projector on PROJECTOR_PORT.
HTTP_ADDR=127.0.0.1:8080
API_PORT=8080
PROJECTOR_PORT=8081
LOG_LEVEL=info

# MySQL 8.4 (docker-compose.yaml). Bound to 127.0.0.1 only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=inventory
MYSQL_ROOT_PASSWORD=change-me

# Restricted application user (deploy/mysql/grants.sql): no UPDATE/DELETE on es_event.
MYSQL_APP_USER=inventory_app
MYSQL_APP_PASSWORD=change-me

# PostgreSQL 17 read model (docker-compose.yaml). POSTGRES_USER is created by the postgres
# image as a SUPERUSER and is used only by `migrate` (and the grant jobs). The projector and
# sync/rebuild-projections write as POSTGRES_PROJECTOR_USER (deploy/postgres/projector-grants.sql:
# DML on the projected tables and TRUNCATE for rebuilds, no superuser, no schema changes).
# The API reads as POSTGRES_READER_USER.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=inventory_read
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me
POSTGRES_READER_USER=inventory_reader
POSTGRES_READER_PASSWORD=change-me
POSTGRES_PROJECTOR_USER=inventory_projector
POSTGRES_PROJECTOR_PASSWORD=change-me

# Change feed (docker-compose.yaml: kafka, connect). Debezium reads the binlog as
# DEBEZIUM_MYSQL_USER (deploy/mysql/debezium-grants.sql); Connect resolves the password
# from its environment, so it is never stored in the connector config.
# deploy/debezium/es-event-connector.json hard-codes the user `debezium` and the database
# `inventory`: change it too if you change DEBEZIUM_MYSQL_USER or MYSQL_DATABASE.
# All passwords: letters and digits only (they are substituted into the grant SQL).
DEBEZIUM_MYSQL_USER=debezium
DEBEZIUM_MYSQL_PASSWORD=change-me
KAFKA_PORT=9092
CONNECT_PORT=8083

# Projection consumer (`make run-projector`).
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=inventory.inventory.es_event
KAFKA_CONSUMER_GROUP=inventory-projector
PROJECTOR_HTTP_ADDR=127.0.0.1:8081
# Apply everything committed in MySQL before consuming (recommended; see docs/05 §7).
PROJECTOR_STARTUP_SYNC=true

# Optional full DSNs overriding the variables above:
#   MYSQL_DSN          used by `api`, `projector` and the projection commands (restricted application user)
#   MYSQL_MIGRATE_DSN  used by `migrate` (admin account; default root + MYSQL_ROOT_PASSWORD)
#   PG_DSN             used by `migrate` (admin)
#   PG_PROJECTOR_DSN   used by `projector`, `sync-projections`, `rebuild-projections` (projection writer)
#   PG_READ_DSN        used by `api` (read-only role)

# Integration tests (`make test-integration`) need an admin DSN: each test creates and
# drops its own throwaway database. No database name in the DSN.
MYSQL_TEST_DSN=root:change-me@tcp(127.0.0.1:3306)/
# Admin PostgreSQL URL without a database name; tests create and drop their own databases.
PG_TEST_DSN=postgres://inventory:change-me@127.0.0.1:5432/postgres?sslmode=disable
# Pipeline tests (`make test-pipeline`) additionally need Kafka and Kafka Connect. The
# connectors they register reach MySQL as CDC_TEST_MYSQL_HOST from inside Compose.
KAFKA_TEST_BROKERS=127.0.0.1:9092
CONNECT_TEST_URL=http://127.0.0.1:8083
CDC_TEST_MYSQL_HOST=mysql
# `make e2e`: business flow against a running API.
E2E_BASE_URL=http://127.0.0.1:8080
