# Copy to .env (git-ignored) and replace every change-me value. Never commit .env.
# All passwords: letters and digits only (they are substituted into the grant SQL).

# HTTP API (`make run-api`). In containers (make stack-up) the API listens on
# 0.0.0.0:8080 inside and is published on 127.0.0.1:API_PORT.
HTTP_ADDR=127.0.0.1:8080
API_PORT=8080
LOG_LEVEL=info

# PostgreSQL 17 (docker-compose.yaml), bound to 127.0.0.1 only. One database holds the
# schemas event_store and read_model; `migrate` creates both on an empty database.
# POSTGRES_USER is created by the postgres image as a SUPERUSER and is used only by
# `migrate` and the grant jobs.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=inventory_read
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me

# Application writer (deploy/postgres/app-grants.sql), used by `api` for commands:
# INSERT/SELECT on es_event (never UPDATE/DELETE), read-model DML, no DDL.
POSTGRES_APP_USER=inventory_app
POSTGRES_APP_PASSWORD=change-me
# Read-only role (deploy/postgres/grants.sql), used by `api` for queries.
POSTGRES_READER_USER=inventory_reader
POSTGRES_READER_PASSWORD=change-me
# Rebuild role (deploy/postgres/rebuild-grants.sql), used by `rebuild-projections`:
# SELECT on es_event, TRUNCATE and DML on the read model.
POSTGRES_REBUILD_USER=inventory_rebuild
POSTGRES_REBUILD_PASSWORD=change-me

# Optional full DSNs overriding the variables above:
#   PG_DSN          used by `migrate` (admin)
#   PG_APP_DSN      used by `api` for commands (application writer)
#   PG_READ_DSN     used by `api` for queries (read-only role)
#   PG_REBUILD_DSN  used by `rebuild-projections` (rebuild role)

# Integration tests (`make test-integration`): admin PostgreSQL URL; each test creates
# and drops its own throwaway database and roles.
PG_TEST_DSN=postgres://inventory:change-me@127.0.0.1:5432/postgres?sslmode=disable
# `make e2e`: business flow against a running API.
E2E_BASE_URL=http://127.0.0.1:8080
